def bootstrap_process_group(
   *,
   dag,
   group_id: str = "bootstrap_process",
   process_id
):
   """
   Bootstrap phase for all pipelines.
   Guarantees:
     - PROCESS_CONTEXT XCom exists
     - process_run_id is resolved
     - etl_date & user_date are available
   """
   with TaskGroup(group_id=group_id, dag=dag) as tg:
       # -------------------------------------------------
       # 1. Fetch ETL / User date
       # -------------------------------------------------
       
       print("Fetching ETL Date")
       
       fetch_etl_date = PythonOperator(
           task_id="fetch_fincore_etl_date",
           python_callable=fetch_fincore_etl_date,
           do_xcom_push=True,
     

       )
       # Expected pushes:
       #   key="etl_date"
       #   key="formatted_date"
       
       # -------------------------------------------------
       # 2. Detect trigger source
       # -------------------------------------------------
       detect_trigger = PythonOperator(
           task_id="detect_trigger_source",
           python_callable=detect_trigger_source,
       )
       # Expected push:
       #   key="trigger_source" (AIRFLOW | SPRING_BOOT | UI)
       
       
       # -------------------------------------------------
       # 3. Branch on trigger source
       # -------------------------------------------------
       branch = BranchPythonOperator(
           task_id="branch_on_trigger",
           python_callable=branch_on_trigger,
       )
       # Returns:
       #   "create_process_run" OR "wait_for_process_run"
       
       # -------------------------------------------------
       # 4A. Scheduler / UI path (entry should be created by airflow )
       # -------------------------------------------------
       create_process_run = PythonOperator(
           task_id="create_process_run",
           python_callable=insert_process_run,
           do_xcom_push=False,
           op_kwargs={"process_id": process_id},
       )
       # This does NOT push process_run_id
       # Spring Boot already created it
       # -------------------------------------------------
       # 4B. Spring Boot path (Entry made by spring boot - wait for entry)
       # -------------------------------------------------
       wait_for_process_run = SqlSensor(
           task_id="wait_for_process_run",
           conn_id="oracle_conn",
           sql="""
               SELECT 1
               FROM process_run
               WHERE airflow_run_id = '{{ run_id }}'
           """,
           poke_interval=5,
           timeout=600,
           mode="reschedule",
       )
       
       # -------------------------------------------------
       # 5. Resolve process_run_id + push PROCESS_CONTEXT
       # -------------------------------------------------
       resolve_process_run = PythonOperator(
           task_id="resolve_process_run_id",
           python_callable=resolve_process_run_id,
           trigger_rule=TriggerRule.NONE_FAILED_MIN_ONE_SUCCESS,
           do_xcom_push=True,
       )
       # Expected push:
       #   key="PROCESS_CONTEXT"
       
       # -------------------------------------------------
       # Wiring
       # -------------------------------------------------
       fetch_etl_date >> detect_trigger >> branch
       branch >> [create_process_run, wait_for_process_run]
       [create_process_run, wait_for_process_run] >> resolve_process_run
       # Expose ONLY the contract boundary
       tg.resolve = resolve_process_run
   return tg   
   
   
