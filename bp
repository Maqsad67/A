def _get_process_run_id(context):
    """
    Wrapper internal helper using the centralized utility.
    """
    try:
        # Use your utility, but explicitly target the resolver task
        pr_id = get_process_run_id(context, task_id="bootstrap_process.resolve_process_run_id")
        
        if not pr_id:
            raise ValueError("ID is empty")
        return pr_id
        
    except Exception as e:
        # Provide a clear error so you know EXACTLY why it failed in the logs
        raise ValueError(
            f"process_run_id not found via utility from 'resolve_process_run_id'. "
            f"Check if task succeeded. Error: {str(e)}"
        )

