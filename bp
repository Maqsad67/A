def detect_trigger_source(**context):

    dag_run = context["dag_run"]
    
    print("DAG_RUN::{}",dag_run)

    if dag_run.run_type == "scheduled":

        source = "SCHEDULER"

    elif dag_run.run_type == "manual":

        conf = dag_run.conf or {}

        source = "FINCORE_BE" if conf.get("triggered_by") == "FINCORE_BE" else "AIRFLOW_UI"

    else:

        source = "UNKNOWN"

    context["ti"].xcom_push(key="trigger_source", value=source)

    print("Trigger source:", source)
    
def branch_on_trigger(**context):

    source = context["ti"].xcom_pull(

        task_ids="bootstrap_process.detect_trigger_source",

        key="trigger_source"

    )

    print(f"Source::::::::::::::{source}")
    
    base_process="bootstrap_process."
    return base_process+"wait_for_process_run" if source == "FINCORE_BE" else base_process+"create_process_run"     

def fetch_fincore_etl_date(**context):
   print("Fetch Started") 
   ti = context["ti"]
   hook = get_oracle_hook()
   records = hook.get_records(
       "SELECT etl_date FROM fincore_date"
   )
   
#    if not records:
#        raise AirflowFailException("FINCORE_DATE table is empty")
   etl_date = records[0][0]  
   formatted_date = etl_date.strftime('%Y%m%d')
   report_date = etl_date.strftime('%d-%m-%Y')
   ti.xcom_push(key="etl_date", value=etl_date)
   ti.xcom_push(key="formatted_date", value=formatted_date)
   ti.xcom_push(key="report_date", value=report_date)
   print("Resolved etl_date:", etl_date) 
   
