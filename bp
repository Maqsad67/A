def stage_wrapper(
    *,
    dag,
    stage_id: str,
    operator_cls,
    operator_kwargs: dict,
    stage_meta: dict,
):
    """
    Wraps ANY operator with:
    - start insert
    - success update
    - failure update
    - clean DAG exits
    """
    def _on_execute(context):    
        ti = context['ti']
    # Pull XCom from this specific task, from any previous attempt
        started_key = f"__stage_started__::{stage_id}"
        print(f"Started Key:{started_key}")
        print(f"TI:{ti}")
        if ti.xcom_pull(key=started_key):
       # Stage already marked STARTED
            return       
        process_run_id = _get_process_run_id(context)
        log_stage_start(process_run_id,stage_id,stage_meta,context=context)
        
        ti.xcom_push(key=started_key, value=True)
    def _on_success(context):
        process_run_id = _get_process_run_id(context)
        log_stage_success(process_run_id,stage_id,stage_meta,context=context)

    def _on_failure(context):
        process_run_id = _get_process_run_id(context)
        log_stage_failure(process_run_id,stage_id,stage_meta,context=context)

    with TaskGroup(group_id=stage_id, dag=dag) as tg:
        main = operator_cls(
            task_id="main",
            on_execute_callback=_on_execute,
            on_success_callback=_on_success,
            on_failure_callback=_on_failure,
            **operator_kwargs,
        )

        stage_success = EmptyOperator(
            task_id="stage_success",
            trigger_rule=TriggerRule.ALL_SUCCESS,
        )

        stage_failure = EmptyOperator(
            task_id="stage_failure",
            trigger_rule=TriggerRule.ONE_FAILED,
        )

        main >> stage_success
        main >> stage_failure
        tg.stage_success = stage_success
        tg.stage_failure = stage_failure
    return tg
   
